    {
      "id": "TC-TimeoutsPermitRetries-Heartbeat-RetryIntervalTooLong-Violation",
      "spec_requirement": 16,
      "name": "heartbeat=10s, initial_interval=5s, schedule_to_close=11s: 2*10 + 5 + 10 = 35 > 11 violates even though heartbeat is set",
      "interceptor_config": {},
      "scenario": {
        "type": "schedule_activity",
        "activity_kind": "regular",
        "activity_options": {
          "schedule_to_close_seconds": 11,
          "start_to_close_seconds": 11,

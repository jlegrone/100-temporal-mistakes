    },
    {
      "id": "TC-MultipleViolations",
      "spec_requirement": 21,
      "name": "Multi-policy violation lists identifiers in canonical order in details payload",
      "interceptor_config": {},
      "scenario": {
        "type": "schedule_activity",
        "activity_kind": "regular",
        "activity_options": {
          "schedule_to_close_seconds": null,
          "start_to_close_seconds": 30,
          "heartbeat_seconds": null,
          "retry_policy": {
            "maximum_attempts": 2
          }
        }
      },
      "expected": {
        "outcome": "violation",
        "application_failure": {
          "type": "PolicyViolationError",
          "non_retryable": true,
          "details_payload_policies": [
            "schedule_to_close_required",
            "max_attempts_must_be_zero_or_at_least_3"
          ]
        },
        "activity_scheduled_on_worker": false
      }
    },
    {
      "id": "TC-AutoHeartbeat-DefaultOn",
      "spec_requirement": 23,
      "name": "AutoHeartbeat is enabled by default and records heartbeats",
      "interceptor_config": {},
      "scenario": {
        "type": "execute_activity",
        "activity_kind": "regular",
        "activity_options": {
          "schedule_to_close_seconds": 600,
          "start_to_close_seconds": null,
          "heartbeat_seconds": 60,
          "retry_policy": null
        },
        "activity_runtime": {
          "duration_seconds": 90,
          "manual_heartbeats": 0
        }
      },
      "expected": {
        "outcome": "execution_succeeded",
        "min_heartbeats_observed": 1
      }
    },
    {
      "id": "TC-AutoHeartbeat-Disabled",
      "spec_requirement": 25,
      "name": "AutoHeartbeat=false suppresses interceptor-emitted heartbeats",
      "interceptor_config": {
        "AutoHeartbeat": false
      },
      "scenario": {
        "type": "execute_activity",
        "activity_kind": "regular",
        "activity_options": {
          "schedule_to_close_seconds": 600,
          "start_to_close_seconds": null,
          "heartbeat_seconds": 60,
          "retry_policy": null
        },
